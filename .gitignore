# --- Sistema operativo y editores ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- Entorno y secretos ---
# Los secretos NUNCA se versionan (§6.1 de Docs/constitution.md).
# Solo se versiona .env.example, que no contiene valores reales.
.env
.env.*
!.env.example

# --- Python (backend) ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Node (frontend) ---
node_modules/
dist/
build/
.vite/
coverage/
npm-debug.log*
yarn-error.log*
.pnpm-store/

# --- Playwright ---
playwright-report/
test-results/
blob-report/
playwright/.cache/

# --- Bases de datos y datos locales ---
