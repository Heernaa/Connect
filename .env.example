# =============================================================================
# Variables de entorno del backend de Connect.
#
# Copia este archivo a `.env` solo si necesitas cambiar algo. El proyecto
# arranca sin `.env`: `docker compose up` ya inyecta los valores de
# desarrollo (§7.0).
#
# `.env` está en `.gitignore` y NUNCA se versiona (§6.1). Este archivo solo
# contiene nombres y ejemplos: ningún valor real.
# =============================================================================

# development | test | production
# En `production` el backend se niega a arrancar con la clave de desarrollo.
ENVIRONMENT=development

# Conexión a PostgreSQL. Dentro de Docker el host es el nombre del servicio.
# Fuera de Docker, en tu máquina, es localhost.
DATABASE_URL=postgresql+psycopg://connect:connect@localhost:5432/connect

# Clave de firma de las sesiones (spec 003).
# OBLIGATORIA en producción: debe ser un valor propio, largo y aleatorio.
# Genérala con:  openssl rand -hex 32
SECRET_KEY=cambia-esto-por-un-valor-propio-y-aleatorio

# Orígenes permitidos por CORS, en notación JSON.
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]